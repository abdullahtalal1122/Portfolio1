# Environment Variables for Portfolio

# Gemini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Next.js Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# For Vercel Deployment:
# 1. Go to your Vercel project settings
# 2. Navigate to "Environment Variables"
# 3. Add GEMINI_API_KEY with your actual API key
# 4. Add NEXT_PUBLIC_SITE_URL with your production URL
# 5. Redeploy your projectini AI API Key (Get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Next.js Config
NEXT_PUBLIC_SITE_URL=http://localhost:3000
